# Production Environment Variables
# Copy this file to .env.production and fill in the values

# Leave EMPTY in Railway production so the SPA calls same-origin /api and /user
# (frontend nginx proxies to the backend over private networking).
# Only set this for special cases where the browser must call the API host directly.
REACT_APP_BASE_API_URL=

# Runtime (Railway frontend service) — required:
# BACKEND_UPSTREAM=http://<backend-service>.railway.internal:8080
# Use your backend's private domain + container port (see Railway → Backend → Networking).

# n8n webhook URL for receipt parsing (find this in your n8n Webhook node)
REACT_APP_N8N_WEBHOOK_URL=https://primary-production-0fe8e.up.railway.app/webhook/your-webhook-id
